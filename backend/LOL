/* ==============================================================================
   MATRIX DIGITAL RAIN CANVAS
   ============================================================================== */
class MatrixRain {
  constructor(canvasId) {
    this.canvas = document.getElementById(canvasId);
    if (!this.canvas) return;
    this.ctx = this.canvas.getContext('2d');
    this.characters = '01ABCDEFΩΨλπ{}<>/*[]=+_~^0123456789アカサタナハマヤラワイキシチニヒミリウクスツヌフムユルエケセテネヘメレオコソトノホモヨロ';
    this.fontSize = 14;
    this.columns = 0;
    this.drops = [];
    this.animId = null;
    this.resize();
    window.addEventListener('resize', () => this.resize());
    this.start();
  }

  resize() {
    this.canvas.width = window.innerWidth;
    this.canvas.height = window.innerHeight;
    this.columns = Math.floor(this.canvas.width / this.fontSize);
    this.drops = [];
    for (let i = 0; i < this.columns; i++) {
      this.drops[i] = Math.floor(Math.random() * -50);
    }
  }

  draw() {
    this.ctx.fillStyle = 'rgba(7, 9, 14, 0.06)';
    this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

    this.ctx.fillStyle = '#00f2fe';
    this.ctx.font = `${this.fontSize}px monospace`;

    for (let i = 0; i < this.drops.length; i++) {
      const char = this.characters.charAt(Math.floor(Math.random() * this.characters.length));
      const x = i * this.fontSize;
      const y = this.drops[i] * this.fontSize;

      if (Math.random() > 0.85) {
        this.ctx.fillStyle = '#ffffff';
      } else if (Math.random() > 0.5) {
        this.ctx.fillStyle = '#00f2fe';
      } else {
        this.ctx.fillStyle = '#39ff14';
      }

      this.ctx.fillText(char, x, y);

      if (y > this.canvas.height && Math.random() > 0.975) {
        this.drops[i] = 0;
      }
      this.drops[i]++;
    }
  }

  start() {
    const loop = () => {
      if (state.matrixEnabled) {
        this.draw();
      }
      this.animId = requestAnimationFrame(loop);
    };
    loop();
  }

  toggle(enabled) {
    if (enabled) {
      this.canvas.classList.remove('hidden');
    } else {
      this.canvas.classList.add('hidden');
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    }
  }
}

