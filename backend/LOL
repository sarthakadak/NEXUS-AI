      terminalPrint('  <span class="cmd-highlight">help</span>               - Display this help manual');
      terminalPrint('  <span class="cmd-highlight">status</span>             - Check status of the 3 challenge sectors');
      terminalPrint('  <span class="cmd-highlight">hint [1|2|3]</span>       - Retrieve tactical intel on a sector');
      terminalPrint('  <span class="cmd-highlight">matrix</span>             - Toggle digital rain backdrop');
      terminalPrint('  <span class="cmd-highlight">audio</span>              - Toggle audio sound effects');
      terminalPrint('  <span class="cmd-highlight">clear</span> or <span class="cmd-highlight">cls</span>       - Clear the terminal console buffer');
      terminalPrint('  <span class="cmd-highlight">whoami</span>             - Print current agent clearance');
      terminalPrint('  <span class="cmd-highlight">cat mission.txt</span>    - Read mission briefing');
      break;

    case 'status':
      terminalPrint(`RECONNAISSANCE REPORT:`, 'text-cyan');
      terminalPrint(`  Sector 1 [HTML]: Inspect DOM tree / hidden elements`);
      terminalPrint(`  Sector 2 [CSS]:  Inspect style.css / pseudo-elements`);
      terminalPrint(`  Sector 3 [JAVA]: Inspect Console & decryptSector3()`);
      break;

    case 'hint':
      const secNum = parseInt(arg, 10);
      if (secNum === 1) {
        terminalPrint('CTF{ tim}', 'cmd-highlight');
      } else if (secNum === 2) {
        terminalPrint('CTF{ hak}', 'cmd-highlight');
      } else if (secNum === 3) {
        terminalPrint('CTF{ jam}', 'cmd-highlight');
      } else {
        terminalPrint('Usage: hint 1, hint 2, or hint 3', 'text-muted');
      }
      break;

    case 'matrix':
      state.matrixEnabled = !state.matrixEnabled;
      if (matrix) matrix.toggle(state.matrixEnabled);
      const btnMatrix = document.getElementById('btn-matrix');
      if (btnMatrix) btnMatrix.classList.toggle('active', state.matrixEnabled);
      terminalPrint(`Matrix effect: ${state.matrixEnabled ? 'ENABLED' : 'DISABLED'}`, 'text-cyan');
      break;

    case 'audio':
      state.audioEnabled = !state.audioEnabled;
      audio.enabled = state.audioEnabled;
      const btnAudio = document.getElementById('btn-audio');
      if (btnAudio) btnAudio.innerHTML = state.audioEnabled ? '<span>🔊</span>' : '<span>🔇</span>';
      terminalPrint(`Audio FX: ${state.audioEnabled ? 'ENABLED' : 'MUTED'}`, 'text-cyan');
      break;

    case 'clear':
    case 'cls':
      const history = document.getElementById('terminal-history');
      if (history) history.innerHTML = '';
      break;

    case 'whoami':
      terminalPrint('agent: operator_0x8f [CLEARANCE: RECON OPERATOR]', 'text-green');
      terminalPrint('origin: DevTools Terminal Subsystem v3.4.19');
      break;

    case 'cat':
      if (arg.toLowerCase() === 'mission.txt') {
        terminalPrint('--- CLASSIFIED MEMO ---', 'text-cyan');
        terminalPrint('Objective: Capture all 3 flags hidden across the 3 fundamental web layers.');
        terminalPrint('Sector 1: HTML pioneer (DOM inspection)');
        terminalPrint('Sector 2: CSS pioneer (style.css inspection)');
        terminalPrint('Sector 3: Java pioneer (runtime console inspection)');
        terminalPrint('Format: CTF{ ... }');
      } else {
        terminalPrint(`cat: ${escapeHTML(arg)}: Permission denied or file not found.`, 'text-red');
      }
      break;

    default:
      terminalPrint(`Command not recognized: '${escapeHTML(root)}'. Type 'help' for available commands.`, 'text-red');
      break;
  }
}

function escapeHTML(str) {
  return str.replace(/[&<>'"]/g, 
    tag => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;'
    }[tag] || tag)
  );
}

/* ==============================================================================
   SESSION STOPWATCH TIMER
   ============================================================================== */
function initStopwatch() {
  const timerEl = document.getElementById('session-timer');
  if (!timerEl) return;

  setInterval(() => {
    const elapsed = Math.floor((Date.now() - state.startTime) / 1000);
    const hrs = String(Math.floor(elapsed / 3600)).padStart(2, '0');
    const mins = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
    const secs = String(elapsed % 60).padStart(2, '0');
    timerEl.textContent = `${hrs}:${mins}:${secs}`;
  }, 1000);
}

